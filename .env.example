# Copy to .env.local and fill in (never commit this file)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — enables real email notifications (free Resend account).
# Without these, notifications appear only in the in-app bell.
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFY_FROM=TeamSetu <notifications@yourdomain.com>
